[Unit]
Description=Launch InvenioRDM Web Interface

[Service]
Type=simple
User=ubuntu
StandardOutput=kmsg
StandardError=kmsg
WorkingDirectory=/Sites/caltechthesis
EnvironmentFile=/Sites/caltechthesis/.env
ExecStart=/snap/bin/uv run --frozen --no-dev --no-sync uwsgi --logger syslog:inveniordm_rest uwsgi_rest.ini

[Install]
WantedBy=multi-user.target
